<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to hidden files
    RewriteCond %{REQUEST_URI} "!(^|/)\.well-known([^/]+)?$"
    RewriteRule "(^|/)\." - [F]

    # Redirect all traffic to the public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>